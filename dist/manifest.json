{
  "manifest_version": 3,
  "name": "Google Meet Transcription",
  "version": "1.0.1",
  "permissions": ["tabCapture", "offscreen", "tabs", "storage"],
  "host_permissions": ["*://meet.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/not-recording.png",
    "default_title": "Toggle Transcription Panel"
  },
  "content_scripts": [
    {
      "matches": ["*://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "panel.html", "panel.css", "pcm-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
